<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox
    maxWidth="Infinity"
    maxHeight="Infinity"
    xmlns="http://javafx.com/javafx/23.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.javafx.controladores.ArtistasController">

    <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="content-toolbar">

        <ProgressIndicator fx:id="loadingSpinner" visible="false" managed="false"
            prefWidth="22.0" prefHeight="22.0" progress="-1.0" styleClass="toolbar-spinner" />

        <Button onAction="#btnRecargar" styleClass="button-secondary" graphicTextGap="7.0" text="Recargar">
            <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnCrear" styleClass="button" graphicTextGap="7.0" text="Nuevo perfil">
            <graphic><FontIcon iconLiteral="fas-plus" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnEditar" styleClass="button" graphicTextGap="7.0" text="Editar perfil">
            <graphic><FontIcon iconLiteral="fas-pen" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnVerValoraciones" styleClass="button-secondary" graphicTextGap="7.0" text="Ver valoraciones">
            <graphic><FontIcon iconLiteral="fas-star" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnPendientes" styleClass="button-warning" graphicTextGap="7.0" text="Pendientes">
            <graphic><FontIcon iconLiteral="fas-user-clock" iconSize="12"/></graphic>
        </Button>

        <HBox HBox.hgrow="ALWAYS" />

        <TextField fx:id="txtBuscar" promptText="Buscar por nombre, especialidad..."
            prefWidth="260.0" styleClass="toolbar-search" />
    </HBox>

    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre"         text="Artista"        prefWidth="150.0" />
            <TableColumn fx:id="colEstudio"        text="Estudio"        prefWidth="130.0" />
            <TableColumn fx:id="colEspecialidades" text="Especialidades" prefWidth="160.0" />
            <TableColumn fx:id="colAnios"          text="Experiencia"    prefWidth="90.0" />
            <TableColumn fx:id="colInstagram"      text="Instagram"      prefWidth="120.0" />
            <TableColumn fx:id="colPrecio"         text="Precio/h"       prefWidth="85.0" />
            <TableColumn fx:id="colActivo"         text="Estado"         prefWidth="75.0" />
            <TableColumn fx:id="colSeguidores"     text="Seguidores"     prefWidth="85.0" />
            <TableColumn fx:id="colValoracion"     text="Valoración"     prefWidth="110.0" />
        </columns>
        <placeholder>
            <Label text="Sin artistas" style="-fx-text-fill: #7c80a8;" />
        </placeholder>
    </TableView>

    <HBox styleClass="status-bar">
        <Label fx:id="lblStatus" text="" styleClass="label" style="-fx-font-size: 11px; -fx-text-fill: #6b7094;" />
    </HBox>
</VBox>
