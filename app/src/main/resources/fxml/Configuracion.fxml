<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane
    fitToWidth="true"
    hbarPolicy="NEVER"
    maxWidth="Infinity"
    maxHeight="Infinity"
    styleClass="settings-scroll"
    xmlns="http://javafx.com/javafx/23.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.javafx.controladores.ConfiguracionController">

    <VBox spacing="20" style="-fx-padding: 28 36; -fx-background-color: transparent;">

        <!-- ══ CUENTA ══ -->
        <VBox styleClass="settings-card" spacing="14">
            <Label text="CUENTA" styleClass="settings-section-header" />

            <HBox alignment="CENTER_LEFT" spacing="16">
                <!-- Avatar con inicial -->
                <StackPane styleClass="settings-avatar">
                    <Label fx:id="lblAvatar" text="?" />
                </StackPane>

                <VBox spacing="4">
                    <Label fx:id="lblEmail" text="—" styleClass="settings-value" />
                    <Label fx:id="lblRol"   text="—" styleClass="settings-muted" />
                </VBox>
            </HBox>
        </VBox>

        <!-- ══ APARIENCIA ══ -->
        <VBox styleClass="settings-card" spacing="14">
            <Label text="APARIENCIA" styleClass="settings-section-header" />

            <!-- Fila: tema -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Tema de la aplicación" styleClass="settings-row-label" />
                    <Label text="Oscuro, Claro o seguir el tema del sistema operativo" styleClass="settings-muted" />
                </VBox>

                <!-- Toggle oscuro / sistema / claro -->
                <HBox spacing="0"
                    style="-fx-background-color: #0f1220;
                           -fx-background-radius: 8;
                           -fx-border-color: rgba(233,69,96,0.2);
                           -fx-border-width: 1;
                           -fx-border-radius: 8;
                           -fx-padding: 3;">
                    <Button fx:id="btnDark"   text="Oscuro"  onAction="#setDarkMode"   styleClass="theme-btn" graphicTextGap="6.0">
                        <graphic><FontIcon iconLiteral="fas-moon"    iconSize="11"/></graphic>
                    </Button>
                    <Button fx:id="btnSystem" text="Sistema" onAction="#setSystemMode" styleClass="theme-btn" graphicTextGap="6.0">
                        <graphic><FontIcon iconLiteral="fas-desktop" iconSize="11"/></graphic>
                    </Button>
                    <Button fx:id="btnLight"  text="Claro"   onAction="#setLightMode"  styleClass="theme-btn" graphicTextGap="6.0">
                        <graphic><FontIcon iconLiteral="fas-sun"     iconSize="11"/></graphic>
                    </Button>
                </HBox>
            </HBox>

            <Separator style="-fx-background-color: rgba(233,69,96,0.12);" />

            <!-- Fila: info del estado del tema -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="lblThemeInfo" text="Tema activo: Sistema" styleClass="settings-muted" />
                <Label fx:id="lblSystemDetected" text="" styleClass="settings-muted" />
            </HBox>
        </VBox>

        <!-- ══ INFORMES ══ -->
        <VBox styleClass="settings-card" spacing="14">
            <Label text="INFORMES" styleClass="settings-section-header" />

            <!-- Fila: directorio de guardado -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Directorio de guardado de PDFs" styleClass="settings-row-label" />
                    <Label text="Carpeta predeterminada al guardar informes generados" styleClass="settings-muted" />
                </VBox>
            </HBox>

            <!-- Ruta actual + botones -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="txtPdfDir" editable="false" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: rgba(15,18,32,0.6);
                           -fx-text-fill: #b0b4d0;
                           -fx-border-color: rgba(233,69,96,0.22);
                           -fx-border-width: 1;
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-font-size: 11px;
                           -fx-padding: 6 10;" />
                <Button onAction="#seleccionarDirectorioPdf" styleClass="button-secondary"
                        graphicTextGap="6.0" text="Cambiar">
                    <graphic><FontIcon iconLiteral="fas-folder-open" iconSize="12"/></graphic>
                </Button>
                <Button onAction="#resetearDirectorioPdf" styleClass="button-secondary"
                        graphicTextGap="6.0" text="Restablecer">
                    <graphic><FontIcon iconLiteral="fas-undo" iconSize="12"/></graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- ══ ACERCA DE ══ -->
        <VBox styleClass="settings-card" spacing="10">
            <Label text="ACERCA DE" styleClass="settings-section-header" />

            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="TattooAge Admin Panel" styleClass="settings-value" />
                    <Label text="Gestión integral de estudio de tatuajes" styleClass="settings-muted" />
                </VBox>
                <Label text="v1.0"
                    style="-fx-font-size: 11px;
                           -fx-text-fill: #6b7094;
                           -fx-background-color: rgba(233,69,96,0.1);
                           -fx-background-radius: 4;
                           -fx-padding: 3 8;
                           -fx-border-color: rgba(233,69,96,0.2);
                           -fx-border-width: 1;
                           -fx-border-radius: 4;" />
            </HBox>

            <Separator style="-fx-background-color: rgba(233,69,96,0.12);" />

            <HBox spacing="32">
                <VBox spacing="3">
                    <Label text="TECNOLOGÍA" styleClass="settings-muted" />
                    <Label text="JavaFX 23" styleClass="settings-row-label" />
                </VBox>
                <VBox spacing="3">
                    <Label text="BACKEND" styleClass="settings-muted" />
                    <Label text="Spring Boot + REST" styleClass="settings-row-label" />
                </VBox>
                <VBox spacing="3">
                    <Label text="BASE DE DATOS" styleClass="settings-muted" />
                    <Label text="MySQL" styleClass="settings-row-label" />
                </VBox>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>
