<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox
    maxWidth="Infinity"
    maxHeight="Infinity"
    xmlns="http://javafx.com/javafx/23.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.javafx.controladores.EstudiosController">

    <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="content-toolbar">

        <ProgressIndicator fx:id="loadingSpinner" visible="false" managed="false"
            prefWidth="22.0" prefHeight="22.0" progress="-1.0" styleClass="toolbar-spinner" />

        <Button onAction="#btnRecargar" styleClass="button-secondary" graphicTextGap="7.0" text="Recargar">
            <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnCrear" styleClass="button-success" graphicTextGap="7.0" text="Crear">
            <graphic><FontIcon iconLiteral="fas-plus" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnEditar" styleClass="button" graphicTextGap="7.0" text="Editar">
            <graphic><FontIcon iconLiteral="fas-pen" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnEliminar" styleClass="button-danger" graphicTextGap="7.0" text="Eliminar">
            <graphic><FontIcon iconLiteral="fas-trash-alt" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnAbrirMaps" styleClass="button-secondary" graphicTextGap="7.0" text="Ver en Maps">
            <graphic><FontIcon iconLiteral="fas-map-marker-alt" iconSize="12"/></graphic>
        </Button>

        <HBox HBox.hgrow="ALWAYS" />

        <TextField fx:id="txtBuscar" promptText="Buscar por nombre, ciudad o web..."
            prefWidth="240.0" styleClass="toolbar-search" />
    </HBox>

    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"           text="ID"           prefWidth="55.0" />
            <TableColumn fx:id="colNombre"       text="Nombre"       prefWidth="160.0" />
            <TableColumn fx:id="colCiudad"       text="Ciudad"       prefWidth="110.0" />
            <TableColumn fx:id="colTelefono"     text="Teléfono"     prefWidth="110.0" />
            <TableColumn fx:id="colEmail"        text="Email"        prefWidth="170.0" />
            <TableColumn fx:id="colWeb"          text="Web"          prefWidth="150.0" />
            <TableColumn fx:id="colLocalizacion" text="Localización ↗" prefWidth="190.0" />
        </columns>
        <placeholder>
            <Label text="Sin estudios" style="-fx-text-fill: #7c80a8;" />
        </placeholder>
    </TableView>

    <HBox styleClass="status-bar">
        <Label fx:id="lblStatus" text="" style="-fx-font-size: 11px; -fx-text-fill: #6b7094;" />
    </HBox>
</VBox>
