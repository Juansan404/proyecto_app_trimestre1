<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane
    prefWidth="760.0"
    prefHeight="640.0"
    style="-fx-background-color: transparent;"
    xmlns="http://javafx.com/javafx/23.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.javafx.controladores.LoginController">

    <!-- ── Fondo: imagen de tatuaje ── -->
    <ImageView fitWidth="760" fitHeight="640" preserveRatio="false">
        <image><Image url="@../images/background_image.png" /></image>
    </ImageView>

    <!-- ── Overlay oscuro encima ── -->
    <StackPane style="-fx-background-color: rgba(0,0,0,0.82);" />

    <!-- ── Tarjeta de login centrada ── -->
    <VBox
        alignment="CENTER"
        spacing="16.0"
        maxWidth="420.0"
        style="-fx-background-color: rgba(20,20,20,0.97);
               -fx-background-radius: 18;
               -fx-padding: 32 40 38 40;
               -fx-border-color: rgba(255,255,255,0.06);
               -fx-border-width: 1;
               -fx-border-radius: 18;
               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.85), 60, 0, 0, 16);">
        <StackPane.margin><Insets top="32" bottom="32" /></StackPane.margin>

        <!-- ── Logo + título ── -->
        <HBox alignment="CENTER" spacing="14">

            <!-- Badge circular con clip real — evita desbordamiento del icono -->
            <StackPane
                prefWidth="62.0" minWidth="62.0" maxWidth="62.0"
                prefHeight="62.0" minHeight="62.0" maxHeight="62.0"
                style="-fx-background-color: white;
                       -fx-effect: dropshadow(gaussian, rgba(192,57,43,0.85), 20, 0.25, 0, 0);">
                <clip><Circle centerX="31.0" centerY="31.0" radius="31.0"/></clip>
                <ImageView fitWidth="38" fitHeight="38" preserveRatio="true" smooth="true">
                    <image><Image url="@../images/logo.png" requestedWidth="76" requestedHeight="76" preserveRatio="true" smooth="true" /></image>
                </ImageView>
            </StackPane>

            <VBox alignment="CENTER_LEFT" spacing="2">
                <Label text="TATTOOAGE"
                    style="-fx-font-size: 26px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #C0392B;
                           -fx-font-family: 'Segoe UI';
                           -fx-effect: dropshadow(gaussian, rgba(192,57,43,0.45), 10, 0, 0, 0);" />
                <Label text="Panel de Administración"
                    style="-fx-font-size: 11px;
                           -fx-text-fill: #666666;
                           -fx-font-family: 'Segoe UI';" />
            </VBox>
        </HBox>

        <Separator style="-fx-background-color: rgba(192,57,43,0.2);" />

        <!-- ── Tab login / registro ── -->
        <HBox spacing="0"
            style="-fx-background-color: #111111;
                   -fx-background-radius: 10;
                   -fx-border-color: rgba(192,57,43,0.18);
                   -fx-border-width: 1;
                   -fx-border-radius: 10;">
            <Button fx:id="btnTabLogin" text="Iniciar sesión" onAction="#mostrarLogin" maxWidth="Infinity"
                style="-fx-background-color: #C0392B;
                       -fx-text-fill: white; -fx-font-family: 'Segoe UI';
                       -fx-font-size: 12px; -fx-font-weight: bold;
                       -fx-padding: 10 0; -fx-background-radius: 9 0 0 9;
                       -fx-cursor: hand; -fx-border-color: transparent;
                       -fx-effect: none; -fx-min-height: 0; -fx-pref-height: 38;">
                <HBox.hgrow>ALWAYS</HBox.hgrow>
            </Button>
            <Button fx:id="btnTabReg" text="Registrarse" onAction="#mostrarRegistro" maxWidth="Infinity"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #666666; -fx-font-family: 'Segoe UI';
                       -fx-font-size: 12px; -fx-padding: 10 0;
                       -fx-background-radius: 0 9 9 0; -fx-cursor: hand;
                       -fx-border-color: transparent; -fx-effect: none;
                       -fx-min-height: 0; -fx-pref-height: 38;">
                <HBox.hgrow>ALWAYS</HBox.hgrow>
            </Button>
        </HBox>

        <!-- ══ PANEL LOGIN ══ -->
        <VBox fx:id="panelLogin" spacing="13.0">

            <VBox spacing="5.0">
                <Label text="Email" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" />
                <TextField fx:id="txtLoginEmail" promptText="admin@tattooage.com"
                    style="-fx-background-color: #1A1A1A; -fx-text-fill: #F0F0F0;
                           -fx-prompt-text-fill: #666666; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 11 14;
                           -fx-border-color: rgba(192,57,43,0.22); -fx-border-width: 1.5; -fx-font-size: 13px;" />
            </VBox>

            <VBox spacing="5.0">
                <Label text="Contraseña" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" />
                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <StackPane HBox.hgrow="ALWAYS">
                        <PasswordField fx:id="txtLoginPassword" promptText="••••••••"
                            style="-fx-background-color: #1A1A1A; -fx-text-fill: #F0F0F0;
                                   -fx-prompt-text-fill: #666666; -fx-border-radius: 8;
                                   -fx-background-radius: 8; -fx-padding: 11 14;
                                   -fx-border-color: rgba(192,57,43,0.22); -fx-border-width: 1.5; -fx-font-size: 13px;" />
                        <TextField fx:id="txtLoginPasswordVisible" visible="false" managed="false"
                            style="-fx-background-color: #1A1A1A; -fx-text-fill: #F0F0F0;
                                   -fx-prompt-text-fill: #666666; -fx-border-radius: 8;
                                   -fx-background-radius: 8; -fx-padding: 11 14;
                                   -fx-border-color: rgba(192,57,43,0.22); -fx-border-width: 1.5; -fx-font-size: 13px;" />
                    </StackPane>
                    <Button fx:id="btnLoginShowPass" onAction="#toggleLoginPassword"
                        style="-fx-background-color: #1A1A1A; -fx-padding: 9 11;
                               -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-border-color: rgba(192,57,43,0.22); -fx-border-width: 1.5; -fx-border-radius: 8;
                               -fx-effect: none; -fx-min-height: 0; -fx-min-width: 0;">
                        <graphic><FontIcon fx:id="icoLoginShowPass" iconLiteral="fas-eye" iconSize="15" iconColor="#666666"/></graphic>
                    </Button>
                </HBox>
            </VBox>

            <Label fx:id="lblLoginError" text="" visible="false" managed="false"
                wrapText="true" maxWidth="320.0"
                style="-fx-text-fill: #C0392B; -fx-font-size: 12px;
                       -fx-background-color: rgba(192,57,43,0.1);
                       -fx-background-radius: 6; -fx-padding: 8 12;
                       -fx-border-color: rgba(192,57,43,0.3); -fx-border-width: 1; -fx-border-radius: 6;" />

            <Button fx:id="btnAcceder" text="ACCEDER" onAction="#btnLogin" defaultButton="true" maxWidth="Infinity"
                style="-fx-background-color: #C0392B; -fx-text-fill: white;
                       -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-padding: 13; -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: transparent;
                       -fx-effect: dropshadow(gaussian, rgba(192,57,43,0.5), 14, 0, 0, 3);
                       -fx-min-height: 0; -fx-pref-height: 46;" />

            <HBox fx:id="loginSpinnerBox" alignment="CENTER" visible="false" managed="false">
                <ProgressIndicator prefWidth="28.0" prefHeight="28.0" progress="-1.0"
                    style="-fx-progress-color: #C0392B;" />
            </HBox>
        </VBox>

        <!-- ══ PANEL REGISTRO ══ -->
        <VBox fx:id="panelRegistro" spacing="9.0" visible="false" managed="false">

            <VBox spacing="4.0">
                <Label text="Nombre *" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" />
                <TextField fx:id="txtRegNombre" promptText="Tu nombre"
                    style="-fx-background-color: #1A1A1A; -fx-text-fill: #F0F0F0;
                           -fx-prompt-text-fill: #666666; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 10 14;
                           -fx-border-color: rgba(192,57,43,0.22); -fx-border-width: 1.5; -fx-font-size: 13px;" />
            </VBox>
            <VBox spacing="4.0">
                <Label text="Apellidos" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" />
                <TextField fx:id="txtRegApellidos" promptText="Tus apellidos"
                    style="-fx-background-color: #1A1A1A; -fx-text-fill: #F0F0F0;
                           -fx-prompt-text-fill: #666666; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 10 14;
                           -fx-border-color: rgba(192,57,43,0.22); -fx-border-width: 1.5; -fx-font-size: 13px;" />
            </VBox>
            <VBox spacing="4.0">
                <Label text="Email *" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" />
                <TextField fx:id="txtRegEmail" promptText="tu@email.com"
                    style="-fx-background-color: #1A1A1A; -fx-text-fill: #F0F0F0;
                           -fx-prompt-text-fill: #666666; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 10 14;
                           -fx-border-color: rgba(192,57,43,0.22); -fx-border-width: 1.5; -fx-font-size: 13px;" />
            </VBox>
            <VBox spacing="4.0">
                <Label text="Contraseña * (mín. 6 caracteres)" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" />
                <PasswordField fx:id="txtRegPassword" promptText="••••••"
                    style="-fx-background-color: #1A1A1A; -fx-text-fill: #F0F0F0;
                           -fx-prompt-text-fill: #666666; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 10 14;
                           -fx-border-color: rgba(192,57,43,0.22); -fx-border-width: 1.5; -fx-font-size: 13px;" />
            </VBox>
            <VBox spacing="4.0">
                <Label text="Teléfono" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" />
                <TextField fx:id="txtRegTelefono" promptText="+34 600 000 000"
                    style="-fx-background-color: #1A1A1A; -fx-text-fill: #F0F0F0;
                           -fx-prompt-text-fill: #666666; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 10 14;
                           -fx-border-color: rgba(192,57,43,0.22); -fx-border-width: 1.5; -fx-font-size: 13px;" />
            </VBox>

            <Label fx:id="lblRegError" text="" visible="false" managed="false"
                wrapText="true" maxWidth="320.0"
                style="-fx-font-size: 12px; -fx-background-radius: 6; -fx-padding: 8 12;
                       -fx-border-width: 1; -fx-border-radius: 6;" />

            <Button text="CREAR CUENTA" onAction="#btnRegistrar" maxWidth="Infinity"
                style="-fx-background-color: #1A1A1A; -fx-text-fill: white;
                       -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-padding: 13; -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: #C0392B; -fx-border-width: 1.5; -fx-border-radius: 8;
                       -fx-effect: none; -fx-min-height: 0; -fx-pref-height: 46;" />
        </VBox>

    </VBox>
</StackPane>
