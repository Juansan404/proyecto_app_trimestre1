<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox
    maxWidth="Infinity"
    maxHeight="Infinity"
    xmlns="http://javafx.com/javafx/23.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.javafx.controladores.MensajesController">

    <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="content-toolbar">

        <ProgressIndicator fx:id="loadingSpinner" visible="false" managed="false"
            prefWidth="22.0" prefHeight="22.0" progress="-1.0" styleClass="toolbar-spinner" />

        <Button onAction="#btnRecargar" styleClass="button-secondary" graphicTextGap="7.0" text="Recargar">
            <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnCrear" styleClass="button" graphicTextGap="7.0" text="Nuevo">
            <graphic><FontIcon iconLiteral="fas-plus" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnEliminar" styleClass="button-danger" graphicTextGap="7.0" text="Eliminar">
            <graphic><FontIcon iconLiteral="fas-trash-alt" iconSize="12"/></graphic>
        </Button>

        <HBox HBox.hgrow="ALWAYS" />

        <TextField fx:id="txtBuscar" promptText="Buscar por remitente o contenido..."
            prefWidth="260.0" styleClass="toolbar-search" />
    </HBox>

    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"        text="ID"        prefWidth="60.0" />
            <TableColumn fx:id="colSolicitud" text="Solicitud" prefWidth="90.0" />
            <TableColumn fx:id="colRemitente" text="Remitente" prefWidth="160.0" />
            <TableColumn fx:id="colContenido" text="Contenido" prefWidth="370.0" />
            <TableColumn fx:id="colFecha"     text="Fecha"     prefWidth="140.0" />
        </columns>
        <placeholder>
            <Label text="Sin mensajes" style="-fx-text-fill: #7c80a8;" />
        </placeholder>
    </TableView>

    <HBox styleClass="status-bar">
        <Label fx:id="lblStatus" text="" style="-fx-font-size: 11px; -fx-text-fill: #6b7094;" />
    </HBox>
</VBox>
