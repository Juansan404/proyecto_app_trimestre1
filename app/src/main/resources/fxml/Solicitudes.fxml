<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox
    maxWidth="Infinity"
    maxHeight="Infinity"
    xmlns="http://javafx.com/javafx/23.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.javafx.controladores.SolicitudesController">

    <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="content-toolbar">

        <ProgressIndicator fx:id="loadingSpinner" visible="false" managed="false"
            prefWidth="22.0" prefHeight="22.0" progress="-1.0" styleClass="toolbar-spinner" />

        <Button onAction="#btnRecargar" styleClass="button-secondary" graphicTextGap="7.0" text="Recargar">
            <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnCrear" styleClass="button" graphicTextGap="7.0" text="Nueva">
            <graphic><FontIcon iconLiteral="fas-plus" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnEditar" styleClass="button" graphicTextGap="7.0" text="Editar">
            <graphic><FontIcon iconLiteral="fas-pen" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnAceptar" styleClass="button-success" graphicTextGap="7.0" text="Aceptar">
            <graphic><FontIcon iconLiteral="fas-check" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnRechazar" styleClass="button-danger" graphicTextGap="7.0" text="Rechazar">
            <graphic><FontIcon iconLiteral="fas-times" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnCambiarEstado" styleClass="button-secondary" graphicTextGap="7.0" text="Cambiar Estado">
            <graphic><FontIcon iconLiteral="fas-exchange-alt" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnEliminar" styleClass="button-danger" graphicTextGap="7.0" text="Eliminar">
            <graphic><FontIcon iconLiteral="fas-trash-alt" iconSize="12"/></graphic>
        </Button>

        <HBox HBox.hgrow="ALWAYS" />
        <Label text="Estado:" style="-fx-text-fill: #6b7094; -fx-font-size: 11px;" />
        <ComboBox fx:id="comboFiltroEstado" prefWidth="140.0" />
    </HBox>

    <SplitPane dividerPositions="0.62" VBox.vgrow="ALWAYS"
        style="-fx-background-color: #0b0d1a;">

        <VBox style="-fx-background-color: transparent;">
            <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"      text="ID"      prefWidth="55.0" />
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="150.0" />
                    <TableColumn fx:id="colArtista" text="Artista" prefWidth="150.0" />
                    <TableColumn fx:id="colZona"    text="Zona"    prefWidth="110.0" />
                    <TableColumn fx:id="colTamano"  text="Tamaño"  prefWidth="90.0" />
                    <TableColumn fx:id="colEstado"  text="Estado"  prefWidth="100.0" />
                    <TableColumn fx:id="colFecha"   text="Fecha"   prefWidth="100.0" />
                </columns>
                <placeholder>
                    <Label text="Sin solicitudes" style="-fx-text-fill: #7c80a8;" />
                </placeholder>
            </TableView>
        </VBox>

        <VBox style="-fx-background-color: #0b0d1a; -fx-padding: 0;">
            <Label fx:id="lblMensajesHeader"
                text="Selecciona una solicitud para ver los mensajes"
                style="-fx-font-size: 12px; -fx-font-weight: bold;
                       -fx-text-fill: #6b7094;
                       -fx-background-color: #111428;
                       -fx-padding: 12 14;
                       -fx-border-color: rgba(233,69,96,0.25);
                       -fx-border-width: 0 0 1 0;"
                maxWidth="Infinity" />
            <ListView fx:id="listViewMensajes" VBox.vgrow="ALWAYS"
                styleClass="msg-list" />
        </VBox>
    </SplitPane>

    <HBox styleClass="status-bar">
        <Label fx:id="lblStatus" text="" style="-fx-font-size: 11px; -fx-text-fill: #6b7094;" />
    </HBox>
</VBox>
