<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox
    maxWidth="Infinity"
    maxHeight="Infinity"
    xmlns="http://javafx.com/javafx/23.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.javafx.controladores.CitasController">

    <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="content-toolbar">

        <ProgressIndicator fx:id="loadingSpinner" visible="false" managed="false"
            prefWidth="22.0" prefHeight="22.0" progress="-1.0" styleClass="toolbar-spinner" />

        <Button onAction="#btnRecargar" styleClass="button-secondary" graphicTextGap="7.0" text="Recargar">
            <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnCrear" styleClass="button-success" graphicTextGap="7.0" text="Nueva Cita">
            <graphic><FontIcon iconLiteral="fas-plus" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnEditar" styleClass="button" graphicTextGap="7.0" text="Editar">
            <graphic><FontIcon iconLiteral="fas-pen" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnEliminar" styleClass="button-danger" graphicTextGap="7.0" text="Eliminar">
            <graphic><FontIcon iconLiteral="fas-trash-alt" iconSize="12"/></graphic>
        </Button>
        <Button onAction="#btnCambiarEstado" styleClass="button-secondary" graphicTextGap="7.0" text="Cambiar Estado">
            <graphic><FontIcon iconLiteral="fas-exchange-alt" iconSize="12"/></graphic>
        </Button>

        <HBox HBox.hgrow="ALWAYS" />

        <Label text="Estado:" style="-fx-text-fill: #6b7094; -fx-font-size: 11px;" />
        <ComboBox fx:id="comboFiltroEstado" prefWidth="140.0" />
    </HBox>

    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"      text="ID"      prefWidth="60.0" />
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="160.0" />
            <TableColumn fx:id="colArtista" text="Artista" prefWidth="160.0" />
            <TableColumn fx:id="colFecha"   text="Fecha"   prefWidth="110.0" />
            <TableColumn fx:id="colHora"    text="Hora"    prefWidth="80.0" />
            <TableColumn fx:id="colEstado"  text="Estado"  prefWidth="110.0" />
            <TableColumn fx:id="colPrecio"  text="Precio"  prefWidth="90.0" />
        </columns>
        <placeholder>
            <Label text="Sin citas" style="-fx-text-fill: #7c80a8;" />
        </placeholder>
    </TableView>

    <HBox styleClass="status-bar">
        <Label fx:id="lblStatus" text="" style="-fx-font-size: 11px; -fx-text-fill: #6b7094;" />
    </HBox>
</VBox>
